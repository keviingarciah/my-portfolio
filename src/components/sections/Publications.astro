---
import Section from "../Section.astro";

import { publications } from "@/cv-es.json";
---

<Section title="Publicaciones">
  <ul>
    {
      publications.map(({ name, publisher, releaseDate, url, summary }) => {
        const year = releaseDate.slice(0, 4);

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>
                    <a
                      href={url}
                      target="_blank"
                      title={`Ver publicación: ${name}`}
                    >
                      {name}
                    </a>
                  </h3>
                  <h4>{publisher}</h4>
                </div>

                <time>{year}</time>
              </header>

              <footer>
                <p>{summary}</p>
              </footer>
            </article>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article h3 a {
    color: #111;
  }

  article h3 a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: #222;
    font-weight: 400;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
    cursor: default;
  }

  footer p {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
  }
</style>

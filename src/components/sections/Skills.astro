---
import Section from "../Section.astro";

import HTML from "@/icons/html.astro";
import CSS from "@/icons/css.astro";
import JavaScript from "@/icons/javascript.astro";
import TypeScript from "@/icons/typescript.astro";
import React from "@/icons/react.astro";
import Node from "@/icons/node.astro";
import Git from "@/icons/git.astro";
import GitHub from "@/icons/GitHub.astro";
import Tailwind from "@/icons/tailwind.astro";
import NextJS from "@/icons/nextjs.astro";
import PostgreSQL from "@/icons/postgresql.astro";
import AWS from "@/icons/aws.astro";
import Docker from "@/icons/docker.astro";
import MongoDB from "@/icons/mongodb.astro";
import GCP from "@/icons/gcp.astro";
import AstroIcon from "@/icons/astro.astro";
import Kubernetes from "@/icons/kubernetes.astro";
import Go from "@/icons/go.astro";
import Python from "@/icons/python.astro";
import NestJS from "@/icons/nestjs.astro";

const SKILLS_ICONS: Record<string, any> = {
  HTML,
  CSS,
  JavaScript,
  TypeScript,
  React,
  Node,
  Git,
  GitHub,
  Tailwind,
  Svelte,
  PostgreSQL,
  AWS,
  Docker,
  MongoDB,
  GCP,
  Kubernetes,
  NestJS,
  Go,
  Python,
  Astro: AstroIcon,
  NextJS,
};

import { skills } from "@/cv-es.json";
import Svelte from "@/icons/svelte.astro";
---

<Section title="Skills">
  <ul>
    {
      skills.map(({ name }) => {
        const iconName = name === "Next.js" ? "Next" : name;
        const Icon = SKILLS_ICONS[iconName];

        return (
          <li>
            {Icon && <Icon />} <span>{name}</span>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  ul {
    display: inline-flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  li {
    align-items: center;
    background: #eee;
    border-radius: 6px;
    color: black;
    display: flex;
    font-size: 0.8rem;
    font-weight: 500;
    gap: 4px;
    padding: 0.2rem 0.6rem;
  }
</style>
